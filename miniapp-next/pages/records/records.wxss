.records-toolbar{display:flex;flex-direction:column;align-items:stretch;gap:18rpx;margin-top:22rpx}
.records-intro{min-width:0;overflow-wrap:anywhere}
.record-actions{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:12rpx;width:100%}
.record-actions picker{display:block;flex-shrink:0}
.record-actions .chip{margin:0;min-height:40px;padding:10rpx 16rpx;white-space:nowrap}
.record-card{overflow:hidden}
.record-topline{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}
.record-state{flex:1;min-width:0;text-align:right;overflow-wrap:anywhere}
.record-title{margin-top:20rpx;line-height:1.45;overflow-wrap:anywhere}
.record-info{margin-top:8rpx;color:#52635B;line-height:1.55}
.record-info-preview{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden;overflow-wrap:anywhere}
.record-read-more{margin-top:4rpx;color:#0F6E56}
.record-footer{display:flex;flex-direction:column;align-items:stretch;gap:16rpx}
.record-meta{min-width:0;margin-top:0;overflow-wrap:anywhere}
.record-action-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;width:100%}
.record-action-row button{width:100%;min-width:0;min-height:44px;padding:12rpx 8rpx;white-space:nowrap}
.record-edit{background:#EAF3EE;color:#0F6E56}
.record-delete{background:#FFF0EF;color:#A93230}
.record-detail{flex-shrink:0;white-space:nowrap}
@media (max-width:360px){
  .record-action-row{grid-template-columns:repeat(2,minmax(0,1fr))}
  .record-delete{grid-column:1/-1;grid-row:2}
}
