{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "班级公告大屏",
  "version": "0.2.0",
  "identifier": "school.classroom.notice",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "班级公告 · 查看与维护",
        "width": 1280,
        "height": 860,
        "minWidth": 840,
        "minHeight": 620,
        "visible": false,
        "backgroundColor": "#fffdf9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../windows-tts/bin/publish": "windows-tts"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
