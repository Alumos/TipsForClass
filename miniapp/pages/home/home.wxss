.home-heading{align-items:flex-start}
.home-heading-copy{flex:1;min-width:0}
.home-heading .title{overflow-wrap:anywhere}
.home-heading-button{flex-shrink:0;white-space:nowrap}
.room-stack{position:relative;margin-top:24rpx;padding-bottom:10rpx}
.room-stack::before{content:"";position:absolute;left:18rpx;right:18rpx;bottom:0;height:30rpx;border:1rpx solid #DDE8E1;border-radius:20rpx;background:#EEF4F0}
.room-card{position:relative;z-index:1;margin-top:0;padding:28rpx;box-shadow:0 10rpx 28rpx rgba(15,110,86,.08)}
.room-card-head{display:flex;align-items:center;gap:16rpx;min-width:0}
.room-identity{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0}
.room-icon-compact{width:68rpx;height:68rpx;border-radius:18rpx;font-size:30rpx}
.room-heading{flex:1;min-width:0}
.room-kicker{font-size:21rpx;line-height:1.2;letter-spacing:2rpx;color:#7C8F84}
.room-name{margin-top:4rpx;font-size:33rpx;font-weight:650;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.room-actions{width:118rpx;display:flex;align-items:center;justify-content:flex-end;gap:2rpx;flex-shrink:0}
.room-sort{width:78rpx;min-height:36px;padding:8rpx 6rpx;border-radius:12rpx;background:#F0F7F3;color:#0F6E56;font-size:24rpx;font-weight:600;white-space:nowrap}
.room-arrow{width:32rpx;text-align:right;color:#91A198;font-size:38rpx;line-height:1}
.room-device-status{display:flex;align-items:flex-start;gap:12rpx;margin-top:24rpx;padding:16rpx 20rpx;border-radius:14rpx;background:#F5F8F6;color:#52635B}
.room-device-status.online{background:#EDF7F1;color:#245A46}
.device-status-dot{width:14rpx;height:14rpx;margin-top:10rpx;border-radius:50%;background:#A2B1A9;flex-shrink:0}
.room-device-status.online .device-status-dot{background:#1C9A6B;box-shadow:0 0 0 6rpx rgba(28,154,107,.10)}
.room-status-text{flex:1;min-width:0;font-size:26rpx;line-height:1.45;overflow-wrap:anywhere}
.room-heartbeat{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #E8EEEA}
.heartbeat-label{font-size:23rpx;color:#7C8F84;white-space:nowrap;flex-shrink:0}
.heartbeat-time{flex:1;min-width:0;text-align:right;font-size:24rpx;color:#52635B;overflow-wrap:anywhere}
