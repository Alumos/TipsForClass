# 参考用：当前 compose.yaml 直接把变量写在 environment 里，不读取本文件。
# 只有改回 env_file 方式时才需要复制为 .env，并 chmod 600。
# .env 包含密钥，禁止提交到 Git。

APP_MODE=production
HTTP_ADDR=0.0.0.0:8080
DATABASE_PATH=/data/notice.db
TZ=Asia/Shanghai

# 微信公众平台提供。AppSecret 只能放在服务端，绝不能写进小程序代码。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 运行 `openssl rand -hex 32` 生成。更换后现有教师会话和设备令牌会失效。
TOKEN_PEPPER=

# 运行 `openssl rand -hex 16` 生成。只在首位管理员初始化时使用一次。
BOOTSTRAP_CODE=

# 可选 UUID。恢复旧数据库后设置一个新 UUID，可强制所有大屏重新同步。
SYNC_EPOCH=

# 浏览器 Web 前端允许的来源；原生小程序和 Windows 客户端不发送 Origin，不受此限制。
# HTTP 直连模式填 http://服务器IP:18080；启用 Caddy 后填 https://你的域名。
# 留空时仅允许本机 5173/4173 开发端口。
ALLOWED_ORIGINS=https://你的域名,http://tauri.localhost,tauri://localhost

# 仅启用 Caddy（docker compose --profile proxy）时需要，填已备案域名。
NOTICE_DOMAIN=

# 公网高位端口。改这里即可换端口，容器内始终是 8080。
API_PORT=18080
IMAGE_TAG=latest
