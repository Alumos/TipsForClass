# 复制为 .env：cp .env.production.example .env && chmod 600 .env
# .env 包含密钥，禁止提交到 Git。

APP_MODE=production
HTTP_ADDR=0.0.0.0:8080
DATABASE_PATH=/data/notice.db
TZ=Asia/Shanghai

# 微信公众平台提供。AppSecret 只能放在服务端，绝不能写进小程序代码。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 运行 `openssl rand -hex 32` 生成。更换后现有教师会话和设备令牌会失效。
TOKEN_PEPPER=

# 运行 `openssl rand -hex 16` 生成。只在首位管理员初始化时使用一次。
BOOTSTRAP_CODE=

# 可选 UUID。恢复旧数据库后设置一个新 UUID，可强制所有大屏重新同步。
SYNC_EPOCH=

# 浏览器 Web 前端允许的来源；原生小程序和 Windows 客户端通常不发送 Origin。
# 不运行浏览器版时保留公开域名即可。多个来源用英文逗号分隔。
ALLOWED_ORIGINS=https://notice.example.edu.cn

# Compose 变量
NOTICE_DOMAIN=notice.example.edu.cn
API_PORT=8080
IMAGE_TAG=latest
